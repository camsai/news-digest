{
    "name": "news-digest",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "check": "astro check && node --import tsx scripts/validateContent.ts",
        "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "digest": "node --import tsx scripts/generateDigest.ts"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "^7.3.1",
        "@astrojs/rss": "^4.0.19",
        "@github/copilot": "1.0.86",
        "astro": "^7.3.2",
        "fast-xml-parser": "5.11.1",
        "gray-matter": "^4.0.3",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@types/node": "^22.20.2",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^1.0.0",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3"
    }
}
