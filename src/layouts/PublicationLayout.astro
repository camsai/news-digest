---
import { pathTo, publicationName, repositoryUrl } from "../lib/publication";
import "../styles/publication.css";
interface Props {
    title?: string;
    description?: string;
}
const {
    title,
    description = "An entirely AI-generated publication about artificial intelligence in materials science, with links to original sources.",
} = Astro.props;
const pageTitle = title ? `${title} — ${publicationName}` : publicationName;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#101716" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="icon" href={pathTo("favicon.svg")} type="image/svg+xml" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={publicationName}
            href={pathTo("rss.xml")}
        />
        <title>{pageTitle}</title>
    </head>
    <body>
        <a class="skip-link" href="#main">
            Skip to content
        </a>
        <div class="page-shell">
            <header class="site-header">
                <a class="wordmark" href={pathTo()} aria-label="Material Intelligence home">
                    Material Intelligence<span class="brand-dot">●</span>
                </a>
                <nav aria-label="Main navigation">
                    <a href={pathTo("archive/")}>Archive</a>
                    <a href={pathTo("about/")}>Our approach</a>
                    <a class="nav-submit" href={`${repositoryUrl}/issues/new?template=story.yml`}>
                        Suggest a story ↗
                    </a>
                </nav>
            </header>
            <main id="main">
                <slot />
            </main>
            <footer>
                <div>
                    <a class="footer-brand" href={pathTo()}>
                        Material Intelligence
                    </a>
                    <p>Entirely AI-generated. Grounded in original sources.</p>
                </div>
                <div class="footer-links">
                    <a href={pathTo("rss.xml")}>RSS feed ↗</a>
                    <a href={repositoryUrl}>GitHub ↗</a>
                    <a href={pathTo("about/")}>Editorial policy</a>
                </div>
            </footer>
        </div>
    </body>
</html>
