---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/editorial";
import { pathTo } from "../lib/publication";
interface Props {
    articles: CollectionEntry<"articles">[];
}
const { articles } = Astro.props;
---

<div class="article-list">
    {articles.map((article) => (
        <article class="article-row">
            <div class="article-meta">
                <span class="eyebrow">{article.data.kind}</span>
                <time datetime={article.data.date}>{formatDate(article.data.date)}</time>
            </div>
            <div>
                <h2>
                    <a href={pathTo(`articles/${article.id}/`)}>{article.data.title}</a>
                </h2>
                <p>{article.data.description}</p>
            </div>
            <a
                class="read-arrow"
                href={pathTo(`articles/${article.id}/`)}
                aria-label={`Read ${article.data.title}`}
            >
                ↗
            </a>
        </article>
    ))}
    {articles.length === 0 && (
        <p class="empty-state">
            The first edition is in preparation. Follow the RSS feed for new articles.
        </p>
    )}
</div>
