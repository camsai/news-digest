---
import PublicationLayout from "../layouts/PublicationLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import { pathTo, publishedArticles, repositoryUrl } from "../lib/publication";
import { topics, topicSlug } from "../lib/editorial";
const articles = await publishedArticles();
---

<PublicationLayout>
    <section class="hero">
        <div>
            <p class="eyebrow">
                <span class="status-dot"></span> An entirely AI-generated publication
            </p>
            <h1>
                New intelligence.
                <br />
                New <em>materials.</em>
            </h1>
            <p class="hero-description">
                Following the ideas, models, and tools changing how we discover and understand
                matter.
            </p>
            <a class="text-link" href="#latest">
                Explore the publication <span>↓</span>
            </a>
        </div>
        <div class="lattice-panel" aria-hidden="true">
            <svg viewBox="0 0 400 350" fill="none">
                <defs>
                    <pattern id="grid" width="25" height="25" patternUnits="userSpaceOnUse">
                        <circle cx="1" cy="1" r="1" fill="#32483f" />
                    </pattern>
                </defs>
                <rect width="400" height="350" fill="url(#grid)" />
                <g stroke="#527965" stroke-width="1.3">
                    <path d="M100 95 220 55 315 130 195 170ZM100 95V235L195 300V170M315 130V260L195 300M220 55V190L100 235M220 190 315 260M100 95 315 260M220 55 195 300M315 130 100 235" />
                </g>
                <g fill="#9cd6b7">
                    <circle cx="100" cy="95" r="12" />
                    <circle cx="220" cy="55" r="10" />
                    <circle cx="315" cy="130" r="13" />
                    <circle cx="195" cy="170" r="17" />
                    <circle cx="100" cy="235" r="12" />
                    <circle cx="195" cy="300" r="11" />
                    <circle cx="315" cy="260" r="10" />
                </g>
                <circle cx="220" cy="190" r="11" fill="#f0b078" />
            </svg>
            <span class="diagram-caption">STRUCTURE → LEARNING → DISCOVERY</span>
        </div>
    </section>
    <div class="coverage-strip">
        <span class="eyebrow">On our radar</span>
        {topics.map((topic) => (
            <a href={pathTo(`topics/${topicSlug(topic)}/`)}>{topic}</a>
        ))}
    </div>
    <section id="latest" class="latest-section">
        <div class="section-heading">
            <h2>The reading room</h2>
            <a href={pathTo("archive/")}>All articles ↗</a>
        </div>
        <ArticleList articles={articles.slice(0, 5)} />
    </section>
    <section class="editorial-note">
        <p class="eyebrow">Less noise. More context.</p>
        <div>
            <h2>
                A useful signal for people
                <br />
                who work with materials.
            </h2>
            <p>
                Research with its caveats. Software with its applications. Every article connects
                you to the original sources, so you can make your own assessment.
            </p>
            <a class="text-link" href={pathTo("about/")}>
                How we read the field ↗
            </a>
        </div>
    </section>
    <section class="contribute">
        <div>
            <p class="eyebrow">From the community</p>
            <h2>Something we should be reading?</h2>
            <p>Share a paper, a new capability, or a release worth understanding.</p>
        </div>
        <a class="button" href={`${repositoryUrl}/issues/new?template=story.yml`}>
            Suggest a story ↗
        </a>
    </section>
</PublicationLayout>
